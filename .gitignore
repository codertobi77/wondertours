# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# LWS packaging output
dist-lws/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/lib/generated/prisma

# php-api (Perso) : config locale, médias déposés, logs
/php-api/config.local.php
/php-api/uploads/
/php-api/logs/
/uploads/

# agent tooling
/.agents/
/.claude/
/.windsurf/
skills-lock.json

# Laravel (backend)
/laravel/vendor/
/laravel/.env
/laravel/.env.backup
/laravel/.env.production
/laravel/storage/*.key
/laravel/storage/pail/
/laravel/storage/logs/
/laravel/public/storage
/laravel/public/hot
/laravel/public/build
/laravel/.phpunit.cache
/laravel/.phpunit.result.cache
