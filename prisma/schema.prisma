// Schéma Prisma — Wonder Tours
// Basé sur docs/database-schema.md (12 tables)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserRole {
  admin
  editor
  viewer
}

enum Difficulty {
  easy
  moderate
  challenging
}

enum BookingType {
  circuit
  stay
  hotel
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum RequestType {
  circuit
  stay
  hotel
  info
  other
}

enum ContactRequestStatus {
  new
  in_progress
  answered
  closed
}

// ─────────────────────────────── Utilisateurs ───────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  role         UserRole  @default(editor)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  circuits   Circuit[]
  blogPosts  BlogPost[]
  mediaFiles MediaFile[]

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// ─────────────────────────────── Réinitialisation de mot de passe ───────────────────────────────

// Token de réinitialisation « mot de passe oublié » : seul le hash SHA-256
// du token est stocké (jamais le token brut), à usage unique et expirant.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─────────────────────────────── Contenu ───────────────────────────────

model Destination {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  nameEn         String?  @map("name_en") @db.VarChar(100)
  slug           String   @unique @db.VarChar(100)
  description    String?  @db.Text
  descriptionEn  String?  @map("description_en") @db.Text
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  country        String?  @db.VarChar(100)
  region         String?  @db.VarChar(100)
  coordinatesLat Decimal? @map("coordinates_lat") @db.Decimal(10, 8)
  coordinatesLng Decimal? @map("coordinates_lng") @db.Decimal(11, 8)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  circuits Circuit[]

  @@index([isActive])
  @@map("destinations")
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  nameEn        String?  @map("name_en") @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(7)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  circuits Circuit[]

  @@index([isActive])
  @@map("categories")
}

model Circuit {
  id              String      @id @default(uuid()) @db.Uuid
  slug            String      @unique @db.VarChar(255)
  title           String      @db.VarChar(255)
  titleEn         String?     @map("title_en") @db.VarChar(255)
  subtitle        String?     @db.Text
  subtitleEn      String?     @map("subtitle_en") @db.Text
  description     String?     @db.Text
  descriptionEn   String?     @map("description_en") @db.Text
  destinationId   String?     @map("destination_id") @db.Uuid
  categoryId      String?     @map("category_id") @db.Uuid
  durationDays    Int?        @map("duration_days")
  durationNights  Int?        @map("duration_nights")
  price           Decimal     @db.Decimal(10, 2)
  currency        String      @default("XOF") @db.VarChar(3)
  imageUrl        String?     @map("image_url") @db.VarChar(500)
  gallery         Json?
  highlights      Json?
  highlightsEn    Json?       @map("highlights_en")
  itinerary       Json?
  itineraryEn     Json?       @map("itinerary_en")
  included        Json?
  includedEn      Json?       @map("included_en")
  excluded        Json?
  excludedEn      Json?       @map("excluded_en")
  difficulty      Difficulty?
  minParticipants Int?        @map("min_participants")
  maxParticipants Int?        @map("max_participants")
  isFeatured      Boolean     @default(false) @map("is_featured")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  createdBy       String?     @map("created_by") @db.Uuid

  destination  Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  testimonials Testimonial[]
  bookings     Booking[]

  @@index([slug])
  @@index([destinationId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("circuits")
}

model Testimonial {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  country    String?   @db.VarChar(100)
  rating     Int       @db.SmallInt
  text       String    @db.Text
  textEn     String?   @map("text_en") @db.Text
  circuitId  String?   @map("circuit_id") @db.Uuid
  avatarUrl  String?   @map("avatar_url") @db.VarChar(500)
  date       DateTime? @db.Date
  isVerified Boolean   @default(false) @map("is_verified")
  isFeatured Boolean   @default(false) @map("is_featured")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  circuit Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([rating])
  @@index([isActive])
  @@index([isFeatured])
  @@map("testimonials")
}

// ─────────────────────────────── Blog ───────────────────────────────

model BlogCategory {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  nameEn        String?  @map("name_en") @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  color         String?  @db.VarChar(7)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  posts BlogPost[]

  @@index([isActive])
  @@map("blog_categories")
}

model BlogPost {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(255)
  title       String    @db.VarChar(255)
  titleEn     String?   @map("title_en") @db.VarChar(255)
  excerpt     String?   @db.Text
  excerptEn   String?   @map("excerpt_en") @db.Text
  content     String?   @db.Text
  contentEn   String?   @map("content_en") @db.Text
  categoryId  String?   @map("category_id") @db.Uuid
  authorId    String?   @map("author_id") @db.Uuid
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  gallery     Json?
  tags        Json?
  readTime    Int?      @map("read_time")
  views       Int       @default(0)
  isFeatured  Boolean   @default(false) @map("is_featured")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("blog_posts")
}

// ─────────────────────────────── Services ───────────────────────────────

model Service {
  id            String   @id @default(uuid()) @db.Uuid
  title         String   @db.VarChar(255)
  titleEn       String?  @map("title_en") @db.VarChar(255)
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  icon          String?  @db.VarChar(50)
  href          String?  @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("services")
}

// ─────────────────────────────── Réservations ───────────────────────────────

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  bookingReference String        @unique @map("booking_reference") @db.VarChar(20)
  type             BookingType   @default(circuit)
  circuitId        String?       @map("circuit_id") @db.Uuid
  customerName     String        @map("customer_name") @db.VarChar(255)
  customerEmail    String        @map("customer_email") @db.VarChar(255)
  customerPhone    String?       @map("customer_phone") @db.VarChar(50)
  travelDate       DateTime?     @map("travel_date") @db.Date
  returnDate       DateTime?     @map("return_date") @db.Date
  participants     Int?
  totalPrice       Decimal?      @map("total_price") @db.Decimal(10, 2)
  currency         String        @default("XOF") @db.VarChar(3)
  status           BookingStatus @default(pending)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  circuit Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([travelDate])
  @@map("bookings")
}

// ─────────────────────────────── Contact ───────────────────────────────

model ContactRequest {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(255)
  email       String               @db.VarChar(255)
  phone       String?              @db.VarChar(50)
  subject     String?              @db.VarChar(255)
  requestType RequestType          @default(info) @map("request_type")
  travelDate  DateTime?            @map("travel_date") @db.Date
  travelers   Int?
  message     String?              @db.Text
  status      ContactRequestStatus @default(new)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_requests")
}

// ─────────────────────────────── Paramètres ───────────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String?  @db.Text
  description String?  @db.Text
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// ─────────────────────────────── Médiathèque ───────────────────────────────

model MediaFile {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(500)
  url         String   @db.VarChar(500)
  mimeType    String?  @map("mime_type") @db.VarChar(100)
  size        BigInt?
  width       Int?
  height      Int?
  altText     String?  @map("alt_text") @db.VarChar(255)
  altTextEn   String?  @map("alt_text_en") @db.VarChar(255)
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("media_library")
}
